# Base URL of the ScopeGuard API (API Gateway HTTP API URL in AWS).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to 1 to use the in-browser mock API (no backend needed).
NEXT_PUBLIC_USE_MOCK=0

# Mock only: set to 1 to make mock scans fail (to exercise the error state).
NEXT_PUBLIC_MOCK_FAIL=0

# Optional: show the approved styled prototype at / without using backend services.
# /design/ is always available for design review; its actions use fictional local data.
NEXT_PUBLIC_DESIGN_PREVIEW=0
